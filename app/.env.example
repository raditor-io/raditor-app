# --- Supabase (platform project) ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...): client-safe, RLS applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): server only. Bypasses RLS; used by jobs,
# webhooks, and the invite flow.
SUPABASE_SECRET_KEY=

# --- App ----------------------------------------------------------------------
# Public origin of this app, e.g. http://localhost:4000 in dev.
PUBLIC_APP_URL=http://localhost:4000

# --- Email (invitations + auth OTP codes) -------------------------------------
# Optional in dev: when unset, invitation emails are skipped with a warning and
# auth OTP codes are logged to the server console instead of emailed.
RESEND_API_KEY=
EMAIL_FROM="Raditor <team@mail.raditor.io>"

# Supabase Auth -> Hooks -> Send Email (HTTPS): secret shown by the dashboard
# (v1,whsec_...). All auth emails (signup confirmation etc.) are delivered as
# 6-digit OTP codes through /api/auth/send-email via Resend.
SEND_EMAIL_HOOK_SECRET=

# --- Added in later phases (placeholders documented in the plan) --------------
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
# VENICE_API_KEY=
# VAULT_MASTER_KEY=          # 32 bytes base64, e.g. `openssl rand -base64 32`
# CRON_SECRET=
